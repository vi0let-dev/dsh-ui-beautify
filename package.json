{
  "name": "dsh-ui-beautify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adjust the DSH Web UI appearance: style presets, surface transparency, wallpaper, and fonts.",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vi0let-dev/dsh-ui-beautify.git"
  },
  "homepage": "https://github.com/vi0let-dev/dsh-ui-beautify#readme",
  "bugs": {
    "url": "https://github.com/vi0let-dev/dsh-ui-beautify/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "AUDIT.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "wallpaper",
    "font"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT"
}
